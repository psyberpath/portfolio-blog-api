# .env.example
#
# Copy this file to .env and fill in values for local development.
# DO NOT commit .env to source control.

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=your_db_user
DATABASE_PASSWORD=your_db_password
DATABASE_NAME=blog_db

# Test DB (used by integration tests)
TEST_DATABASE_HOST=localhost
TEST_DATABASE_PORT=5433
TEST_DATABASE_USER=your_test_db_user
TEST_DATABASE_PASSWORD=your_test_db_password
TEST_DATABASE_NAME=blog_db_test

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth / JWT
JWT_SECRET=replace_with_a_strong_secret

# Bcrypt config
SALT_ROUNDS=12

# App
NODE_ENV=development
PORT=3000
